------------------------------------------------------------------
local function handleChat(text)
	if type(text) ~= "string" then return end
	local role = matchRole(text)
	if not role then return end
	if bindByName(text, role) then
		pushLog("[chat] " .. text, true)
	end
end

pcall(function()
	game:GetService("TextChatService").MessageReceived:Connect(function(m)
		handleChat(m.Text)
	end)
end)

pcall(function()
	local ev = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
	if ev and ev:FindFirstChild("OnMessageDoneFiltering") then
		ev.OnMessageDoneFiltering.OnClientEvent:Connect(function(d)
			if d and d.Message then handleChat(d.Message) end
		end)
	end
end)

for _, p in ipairs(Players:GetPlayers()) do
	pcall(function() p.Chatted:Connect(handleChat) end)
end
Players.PlayerAdded:Connect(function(p)
	pcall(function() p.Chatted:Connect(handleChat) end)
end)

local function scanGuiForReveals()
	local budget = 0
	for _, d in ipairs(PGui:GetDescendants()) do
		budget += 1
		if budget > 800 then break end
		if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text then
			local t = d.Text
			if #t > 2 and #t < 160 then
				local r = matchRole(t)
				if r then bindByName(t, r) end
			end
		end
	end
end

------------------------------------------------------------------
-- visual updates
------------------------------------------------------------------
local function update()
	local alive = {}
	for _, p in ipairs(Players:GetPlayers()) do
		alive[p.UserId] = true
		local r = S.rows[p.UserId]
		if not r then
			r = makeRow(p)
			S.rows[p.UserId] = r
		end
		r.dn.Text = p.DisplayName
		r.un.Text = "@" .. p.Name
		local role = S.roles[p.UserId]
		if role then
			r.rb.Text = string.upper(role)
			r.rb.TextColor3 = roleColor(role)
		else
			r.rb.Text = "..."
			r.rb.TextColor3 = C.dim
		end
		local c = p.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if not h or h.Health <= 0 then
			r.dn.TextColor3 = C.dim
			r.un.TextColor3 = Color3.fromRGB(110, 110, 125)
		else
			r.dn.TextColor3 = C.text
			r.un.TextColor3 = C.dim
		end
	end
	for uid, r in pairs(S.rows) do
		if not alive[uid] then r.row:Destroy(); S.rows[uid] = nil end
	end
end

local function updateESP()
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local head = c and c:FindFirstChild("Head")
		if head then
			local bb = head:FindFirstChild("FlickerBB")
			if not bb then
				bb = Instance.new("BillboardGui")
				bb.Name = "FlickerBB"
				bb.Size = UDim2.fromOffset(IS_MOBILE and 190 or 230, 42)
				bb.StudsOffsetWorldSpace = Vector3.new(0, 2.7, 0)
				bb.AlwaysOnTop = true
				bb.MaxDistance = 500
				bb.Parent = head
				local l = Instance.new("TextLabel")
				l.Name = "L"
				l.Size = UDim2.fromScale(1, 1)
				l.BackgroundTransparency = 1
				l.Font = Enum.Font.GothamBold
				l.TextSize = IS_MOBILE and 12 or 13
				l.TextStrokeTransparency = 0.25
				l.TextStrokeColor3 = Color3.new(0, 0, 0)
				l.Text = ""
				l.Parent = bb
			end
			local role = S.roles[p.UserId]
			local txt = "@" .. p.Name
			if role then txt = txt .. "\n" .. string.upper(role) end
			bb.L.Text = txt
			bb.L.TextColor3 = role and roleColor(role) or Color3.fromRGB(255, 236, 150)
		end
	end
end

local function updateHL()
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		if c then
			local role = S.roles[p.UserId]
			local hl = c:FindFirstChild("FlickerHL")
			if role and role ~= "innocent" then
				if not hl then
					hl = Instance.new("Highlight")
					hl.Name = "FlickerHL"
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.FillTransparency = 0.82
					hl.OutlineTransparency = 0.1
					hl.Parent = c
				end
				hl.FillColor = roleColor(role)
				hl.OutlineColor = roleColor(role)
			elseif hl then
				hl:Destroy()
			end
		end
	end
end

------------------------------------------------------------------
-- main loop
------------------------------------------------------------------
local acc, guiAcc = 0, 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	guiAcc += dt
	if guiAcc >= 1.5 then
		guiAcc = 0
		pcall(scanGuiForReveals)
	end
	if acc < (IS_MOBILE and 0.7 or 0.5) then return end
	acc = 0
	pcall(update)
	if ESP_ON then
		pcall(updateESP)
		pcall(updateHL)
	end
	if logDirty then logDirty = false; renderLog() end
	local found = 0
	for _ in pairs(S.roles) do found += 1 end
	status.Text = string.format("%d players  |  %d roles  |  %d remotes",
		#Players:GetPlayers(), found, S.remotes)
end)

------------------------------------------------------------------
-- input  (tap + drag)
------------------------------------------------------------------
local function setOpen(v)
	S.open = v
	main.Visible = v
end

toggle.MouseButton1Click:Connect(function() setOpen(not S.open) end)
closeBtn.MouseButton1Click:Connect(function() setOpen(false) end)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.RightShift then
		setOpen(not S.open)
	end
end)

local dragging, dragStart, startPos
local function isTouchLike(t)
	return t == Enum.UserInputType.MouseButton1
		or t == Enum.UserInputType.Touch
end

title.InputBegan:Connect(function(input)
	if isTouchLike(input.UserInputType) then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if isTouchLike(input.UserInputType) then dragging = false end
end)
UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y)
	end
end)

