------------------------------------------------------------------
-- remote log
------------------------------------------------------------------
local function pushLog(text, hot)
	table.insert(S.log, 1, { text = text, hot = hot })
	while #S.log > 80 do table.remove(S.log) end
	logDirty = true
end

local function renderLog()
	for _, ch in ipairs(logFrame:GetChildren()) do
		if ch:IsA("TextLabel") then ch:Destroy() end
	end
	for i = 1, math.min(#S.log, 40) do
		local e = S.log[i]
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, -4, 0, 14)
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.Code
		l.TextSize = IS_MOBILE and 10 or 11
		l.TextColor3 = e.hot and C.accent or C.dim
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextTruncate = Enum.TextTruncate.AtEnd
		l.Text = e.text
		l.Parent = logFrame
	end
end

------------------------------------------------------------------
-- remote hooking
------------------------------------------------------------------
local function ingestTable(t, depth)
	if depth > 2 or type(t) ~= "table" then return end
	for k, v in pairs(t) do
		local ks, vs = nm(k), nm(v)
		local role = matchRole(ks) or matchRole(vs)
		if role then
			for _, p in ipairs(Players:GetPlayers()) do
				for _, a in ipairs(aliases(p)) do
					if a ~= "" and (ks == a or vs == a
						or string.find(ks, a, 1, true) or string.find(vs, a, 1, true)) then
						S.roles[p.UserId] = role
					end
				end
			end
		end
		if type(v) == "table" then ingestTable(v, depth + 1) end
	end
end

local function handleArgs(name, ...)
	local args = { ... }
	local strs, role = {}, nil
	for _, a in ipairs(args) do
		local s = nm(a)
		table.insert(strs, s)
		local r = matchRole(s)
		if r then role = r end
		if type(a) == "table" then
			ingestTable(a, 0)
			for kk, vv in pairs(a) do
				local r2 = matchRole(nm(kk)) or matchRole(nm(vv))
				if r2 then role = r2 end
			end
		end
	end
	local line = name .. "  " .. table.concat(strs, " | ")
	if #line > 130 then line = string.sub(line, 1, 130) .. "..." end
	pushLog(line, role ~= nil)
	if role then bindByName(line, role) end
end

local hooked = {}
local function hookRemote(r)
	if hooked[r] then return end
	hooked[r] = true
	S.remotes += 1
	if r:IsA("RemoteEvent") then
		pcall(function()
			r.OnClientEvent:Connect(function(...) handleArgs(r.Name, ...) end)
		end)
	end
end

for _, d in ipairs(game:GetDescendants()) do
	if d:IsA("RemoteEvent") then hookRemote(d) end
end
game.DescendantAdded:Connect(function(d)
	if d:IsA("RemoteEvent") then hookRemote(d) end
end)

