------------------------------------------------------------------
-- helpers
------------------------------------------------------------------
local function nm(x)
	if type(x) == "string" then return x end
	local ok, n = pcall(function() return x.Name end)
	if ok and type(n) == "string" then return n end
	return tostring(x)
end

local function matchRole(txt)
	if type(txt) ~= "string" then return nil end
	local low = string.lower(txt)
	for _, w in ipairs(ROLE_WORDS) do
		if string.find(low, w, 1, true) then return w end
	end
	return nil
end

local function roleColor(r)
	if not r then return C.dim end
	if EVIL[r] then return C.bad end
	if NEUT[r] then return C.neut end
	return C.good
end

local function aliases(p)
	local a = { p.Name, p.DisplayName }
	local c = p.Character
	if c then
		table.insert(a, c.Name)
		local h = c:FindFirstChildOfClass("Humanoid")
		if h then table.insert(a, h.DisplayName) end
	end
	return a
end

local function bindByName(text, role)
	if not role then return false end
	local hit = false
	for _, p in ipairs(Players:GetPlayers()) do
		for _, a in ipairs(aliases(p)) do
			if a ~= "" and string.find(text, a, 1, true) then
				S.roles[p.UserId] = role
				hit = true
				break
			end
		end
	end
	return hit
end

local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 6)
	c.Parent = o
	return c
end

