local function applyLayout()
	local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
		or Vector2.new(1280, 720)
	local w, h
	if IS_MOBILE then
		w = math.clamp(math.floor(vp.X * 0.44), 200, 330)
		h = math.clamp(math.floor(vp.Y * 0.88), 200, 520)
		main.Position = UDim2.fromOffset(10, math.floor((vp.Y - h) / 2))
	else
		w, h = 330, 470
		main.Position = UDim2.new(0, 12, 0.5, -235)
	end
	main.Size = UDim2.fromOffset(w, h)
	closeBtn.Position = UDim2.new(1, -(CB + 8), 0, math.floor((TITLE_H - CB) / 2))
end

